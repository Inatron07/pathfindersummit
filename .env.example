# ── Anthropic ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxx
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# ── WhatsApp Cloud API (Meta) ────────────────────────────────────────────────
# From Meta for Developers > your App > WhatsApp > API Setup
WHATSAPP_TOKEN=your-permanent-system-user-access-token
WHATSAPP_PHONE_NUMBER_ID=1234567890
# Any string you make up yourself — you'll enter the SAME value when you
# configure the webhook in the Meta dashboard.
WHATSAPP_VERIFY_TOKEN=choose-a-random-secret-string

# Name + language of the APPROVED template used for the first message to a
# lead that has never messaged you on WhatsApp before (see docs/SETUP_META.md)
OUTREACH_TEMPLATE_NAME=property_followup
OUTREACH_TEMPLATE_LANG=en

# ── Database (Postgres / Neon) ───────────────────────────────────────────
# Get this from your Neon project dashboard. Run db/schema.sql against it once
# (Neon's SQL Editor is the easiest way) before starting the agent.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Business info (used in the agent's system prompt) ───────────────────────
BUSINESS_NAME=Your Real Estate Co
AGENT_NAME=Priya
BUSINESS_CONTEXT="We sell and rent residential apartments in Bangalore. Typical budget range 40L-2Cr. We list on 99acres, MagicBricks and our own site."

# ── Server ───────────────────────────────────────────────────────────────
PORT=3000

# ── Follow the Money AML bot (optional) ─────────────────────────────────
FTM_ENABLED=false
# Your WhatsApp number(s), digits only with country code, comma separated
FTM_ADMIN_PHONES=
# Automation Anywhere Control Room (user + API key allowed to create the request)
AA_URL=https://aa-community.cloud.automationanywhere.digital
AA_USERNAME=
AA_API_KEY=
# FTM_RunAgent public file id and Pathfinder team id (defaults are built in)
AA_PROCESS_FILE_ID=100246079
AA_TEAM_ID=100000768
# Trustworthy Bank API (read-only use here: status and results)
BANK_API_BASE=https://fuxjyedytrihhdolobrz.supabase.co/functions/v1
BANK_API_KEY=
FTM_SCAN_RANGE=2100-2400
FTM_RUN_TIMEOUT_MIN=15
# Minutes between checks for new alerts (0 = off)
FTM_ALERT_POLL_MIN=0
